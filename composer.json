{
  "name": "notrab/jumbo",
  "description": "Content sites on Dumbo: pages from files, layouts, Markdown and static builds.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://notrab.github.io/jumbo",
  "keywords": [
    "static site generator",
    "markdown",
    "dumbo",
    "ssg"
  ],
  "authors": [
    {
      "name": "Jamie Barton",
      "email": "jamie@notrab.dev"
    }
  ],
  "support": {
    "issues": "https://github.com/notrab/jumbo/issues",
    "source": "https://github.com/notrab/jumbo",
    "docs": "https://notrab.github.io/jumbo"
  },
  "require": {
    "php": ">=8.3",
    "notrab/dumbo": "^1.4.4",
    "league/commonmark": "^2.5",
    "symfony/yaml": "^7.4",
    "tempest/highlight": "^2.11"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Dumbo\\Jumbo\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Dumbo\\Jumbo\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/jumbo"
  ],
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
