{
  "require": {
    "notrab/jumbo": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../"
    }
  ],
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "npm run build",
      "jumbo dev"
    ],
    "build": [
      "npm run build",
      "jumbo build"
    ]
  },
  "autoload": {
    "psr-4": {
      "Docs\\": "src/"
    }
  }
}
